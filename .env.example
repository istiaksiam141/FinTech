# Server-side only. Put the real value in .env.local locally or Vercel's
# Environment Variables settings. Never add a real key to this file.
GROQ_API_KEY=replace-with-your-key-locally

# Required server-side to verify saved-conversation references under the user's Supabase RLS.
# Use the project URL and publishable key; never use a service-role/secret key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-with-your-publishable-key

# Optional server-side model override. Defaults to openai/gpt-oss-20b.
# GROQ_MODEL=openai/gpt-oss-20b
